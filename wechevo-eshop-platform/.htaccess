# WeChevo e-shop platform — Apache / LiteSpeed (Hostinger)
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve internals directly
  RewriteRule ^(app|data)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule \.(sqlite|sqlite-wal|sqlite-shm|log|ini|md|lock|bak)$ - [F,L,NC]

  # Static files are served as-is
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(assets|uploads)/ - [L]

  # Everything else goes to the front controller (HTTPS/www/canonical handled in PHP per shop)
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|log|ini|lock)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(css|js|webp|avif|jpg|jpeg|png|gif|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/xml text/plain image/svg+xml
</IfModule>
